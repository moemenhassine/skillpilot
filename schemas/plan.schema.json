{
  "title": "SkillPilot install or removal plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "domain": {
          "type": "string",
          "const": "skillpilot-plan-v1"
        },
        "toolVersion": {
          "type": "string"
        },
        "projectRoot": {
          "type": "string"
        },
        "agents": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex"
            ]
          }
        },
        "policy": {
          "type": "object",
          "properties": {
            "ruleSet": {
              "type": "string"
            },
            "payloadPolicy": {
              "type": "string"
            },
            "policyDigest": {
              "type": "string"
            }
          },
          "required": [
            "ruleSet",
            "payloadPolicy",
            "policyDigest"
          ],
          "additionalProperties": false
        },
        "configDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "disclosures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "planDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "operation": {
          "type": "string",
          "const": "install"
        },
        "skills": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "const": "github"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "repository": {
                    "type": "string"
                  },
                  "skillPath": {
                    "type": "string"
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                },
                "required": [
                  "provider",
                  "owner",
                  "repository",
                  "skillPath",
                  "commit"
                ],
                "additionalProperties": false
              },
              "name": {
                "type": "string"
              },
              "payloadDigest": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sourcePath": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "installedMode": {
                      "type": "string",
                      "const": "0644"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "skill",
                        "license",
                        "notice"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "sourcePath",
                    "size",
                    "sha256",
                    "installedMode",
                    "role"
                  ],
                  "additionalProperties": false
                }
              },
              "license": {
                "type": "object",
                "properties": {
                  "spdx": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "spdx",
                  "files"
                ],
                "additionalProperties": false
              },
              "review": {
                "type": "object",
                "properties": {
                  "ruleSet": {
                    "type": "string"
                  },
                  "policyVersion": {
                    "type": "string"
                  },
                  "coverage": {
                    "type": "string",
                    "const": "complete"
                  },
                  "decision": {
                    "type": "string",
                    "const": "eligible"
                  },
                  "findings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "ruleId": {
                          "type": "string"
                        },
                        "severity": {
                          "type": "string",
                          "enum": [
                            "info",
                            "low",
                            "medium",
                            "high",
                            "critical"
                          ]
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "high",
                            "medium",
                            "low"
                          ]
                        },
                        "file": {
                          "type": "string"
                        },
                        "lineStart": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "lineEnd": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "occurrences": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "explanation": {
                          "type": "string"
                        },
                        "remediation": {
                          "type": "string"
                        },
                        "blocking": {
                          "type": "boolean"
                        },
                        "context": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "ruleId",
                        "severity",
                        "confidence",
                        "file",
                        "occurrences",
                        "explanation",
                        "remediation",
                        "blocking"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "acknowledged": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ruleSet",
                  "policyVersion",
                  "coverage",
                  "decision",
                  "findings",
                  "acknowledged"
                ],
                "additionalProperties": false
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "agent": {
                      "type": "string",
                      "enum": [
                        "claude-code",
                        "codex"
                      ]
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "agent",
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "source",
              "name",
              "payloadDigest",
              "files",
              "license",
              "review",
              "targets"
            ],
            "additionalProperties": false
          }
        },
        "preconditions": {
          "type": "object",
          "properties": {
            "lockfile": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "absent"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "present"
                    },
                    "sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "agent": {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "absent",
                      "managed"
                    ]
                  }
                },
                "required": [
                  "agent",
                  "path",
                  "state"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "lockfile",
            "targets"
          ],
          "additionalProperties": false
        },
        "lockfileChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "add"
              },
              "entry": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "github"
                      },
                      "owner": {
                        "type": "string"
                      },
                      "repository": {
                        "type": "string"
                      },
                      "skillPath": {
                        "type": "string"
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    },
                    "required": [
                      "provider",
                      "owner",
                      "repository",
                      "skillPath",
                      "commit"
                    ],
                    "additionalProperties": false
                  },
                  "name": {
                    "type": "string"
                  },
                  "agent": {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex"
                    ]
                  },
                  "installPath": {
                    "type": "string"
                  },
                  "license": {
                    "type": "object",
                    "properties": {
                      "spdx": {
                        "type": "string"
                      },
                      "files": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "spdx",
                      "files"
                    ],
                    "additionalProperties": false
                  },
                  "payloadDigest": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "sourcePath": {
                          "type": "string"
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "installedMode": {
                          "type": "string",
                          "const": "0644"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "skill",
                            "license",
                            "notice"
                          ]
                        }
                      },
                      "required": [
                        "path",
                        "sourcePath",
                        "size",
                        "sha256",
                        "installedMode",
                        "role"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "ruleSet": {
                    "type": "string"
                  },
                  "findingsSummary": {
                    "type": "object",
                    "properties": {
                      "critical": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "high": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "medium": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "low": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "info": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "info"
                    ],
                    "additionalProperties": false
                  },
                  "acknowledged": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "sourceId",
                  "source",
                  "name",
                  "agent",
                  "installPath",
                  "license",
                  "payloadDigest",
                  "files",
                  "ruleSet",
                  "findingsSummary",
                  "acknowledged"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "op",
              "entry"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "domain",
        "toolVersion",
        "projectRoot",
        "agents",
        "policy",
        "configDigest",
        "disclosures",
        "createdAt",
        "expiresAt",
        "planDigest",
        "operation",
        "skills",
        "preconditions",
        "lockfileChanges"
      ],
      "additionalProperties": false
    },
