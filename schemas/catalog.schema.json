{
  "title": "SkillPilot bundled catalog (catalog/skills.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "name": {
            "type": "string",
            "pattern": "^(?=.{1,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "github"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 39
              },
              "repository": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "skillPath": {
                "type": "string",
                "pattern": "^(\\.|(?!\\/)(?!.*\\/\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._\\-/]{1,240}(?<!\\/))$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "provider",
              "owner",
              "repository",
              "skillPath",
              "commit"
            ],
            "additionalProperties": false
          },
          "categories": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.+-]{0,39}$"
            }
          },
          "stack": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.+-]{0,39}$"
            }
          },
          "requiresAnyStack": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.+-]{0,39}$"
            }
          },
          "tasks": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "accessibility",
                "ai-integration",
                "browser-testing",
                "build-tooling",
                "cloud-workers",
                "code-review",
                "concurrency",
                "data-analysis",
                "data-fetching",
                "database",
                "datasets",
                "debugging",
                "demo-ui",
                "deployment",
                "kotlin-migration",
                "mcp",
                "ml-training",
                "navigation",
                "performance",
                "property-testing",
                "python-tooling",
                "security",
                "testing",
                "ui-design",
                "upgrade"
              ]
            }
          },
          "prerequisites": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "agents": {
            "type": "object",
            "properties": {
              "claude-code": {
                "type": "string",
                "enum": [
                  "verified",
                  "portable",
                  "unknown",
                  "excluded"
                ]
              },
              "codex": {
                "type": "string",
                "enum": [
                  "verified",
                  "portable",
                  "unknown",
                  "excluded"
                ]
              }
            },
            "required": [
              "claude-code",
              "codex"
            ],
            "additionalProperties": false
          },
          "license": {
            "type": "object",
            "properties": {
              "spdx": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "skill",
                  "repository"
                ]
              },
              "evidencePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "spdx",
              "scope",
              "evidencePath"
            ],
            "additionalProperties": false
          },
          "payload": {
            "type": "object",
            "properties": {
              "files": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unsupportedFiles": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "files",
              "bytes",
              "unsupportedFiles"
            ],
            "additionalProperties": false
          },
          "targetSpecificFrontmatter": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verifiedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "source",
          "categories",
          "stack",
          "requiresAnyStack",
          "tasks",
          "prerequisites",
          "agents",
          "license",
          "payload",
          "targetSpecificFrontmatter",
          "verifiedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "catalogVersion",
    "generatedAt",
    "entries"
  ],
  "additionalProperties": false
}
