{
  "title": "SkillPilot project configuration (.skillpilot/config.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "defaultLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "stack": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.+-]{0,39}$"
      }
    },
    "repositories": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$"
      }
    },
    "excludeSkillIds": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "scan": {
      "type": "object",
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "maxParsedFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
