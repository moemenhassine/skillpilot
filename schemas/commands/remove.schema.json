{
  "title": "skillpilot remove --json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "remove"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "plan": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "domain": {
                  "type": "string",
                  "const": "skillpilot-plan-v1"
                },
                "toolVersion": {
                  "type": "string"
                },
                "projectRoot": {
                  "type": "string"
                },
                "agents": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "claude-code",
                      "codex"
                    ]
                  }
                },
                "policy": {
                  "type": "object",
                  "properties": {
                    "ruleSet": {
                      "type": "string"
                    },
                    "payloadPolicy": {
                      "type": "string"
                    },
                    "policyDigest": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ruleSet",
                    "payloadPolicy",
                    "policyDigest"
                  ],
                  "additionalProperties": false
                },
                "configDigest": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "disclosures": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "createdAt": {
                  "type": "string"
                },
                "expiresAt": {
                  "type": "string"
                },
                "planDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "operation": {
                  "type": "string",
                  "const": "remove"
                },
                "removals": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string",
                        "enum": [
                          "claude-code",
                          "codex"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "payloadDigest": {
                        "type": "string"
                      },
                      "files": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string"
                            },
                            "sourcePath": {
                              "type": "string"
                            },
                            "size": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            "installedMode": {
                              "type": "string",
                              "const": "0644"
                            },
                            "role": {
                              "type": "string",
                              "enum": [
                                "skill",
                                "license",
                                "notice"
                              ]
                            }
                          },
                          "required": [
                            "path",
                            "sourcePath",
                            "size",
                            "sha256",
                            "installedMode",
                            "role"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "sourceId",
                      "name",
                      "agent",
                      "path",
                      "payloadDigest",
                      "files"
                    ],
                    "additionalProperties": false
                  }
                },
                "preconditions": {
                  "type": "object",
                  "properties": {
                    "lockfile": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "present"
                        },
                        "sha256": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "state",
                        "sha256"
                      ],
                      "additionalProperties": false
                    },
                    "targets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "agent": {
                            "type": "string",
                            "enum": [
                              "claude-code",
                              "codex"
                            ]
                          },
                          "path": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "const": "managed"
                          }
                        },
                        "required": [
                          "agent",
                          "path",
                          "state"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "lockfile",
                    "targets"
                  ],
                  "additionalProperties": false
                },
                "lockfileChanges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "op": {
                        "type": "string",
                        "const": "remove"
                      },
                      "sourceId": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string",
                        "enum": [
                          "claude-code",
                          "codex"
                        ]
                      }
                    },
                    "required": [
                      "op",
                      "sourceId",
                      "agent"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "schemaVersion",
                "domain",
                "toolVersion",
                "projectRoot",
                "agents",
                "policy",
                "configDigest",
                "disclosures",
                "createdAt",
                "expiresAt",
                "planDigest",
                "operation",
                "removals",
                "preconditions",
                "lockfileChanges"
              ],
              "additionalProperties": false
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "plan",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_ERROR",
              "INVALID_ARGUMENT",
              "INVALID_SCHEMA",
              "SOURCE_UNAVAILABLE",
              "RATE_LIMITED",
              "POLICY_BLOCKED",
              "REVIEW_INCOMPLETE",
              "APPROVAL_REQUIRED",
              "APPROVAL_MISMATCH",
              "APPROVAL_DECLINED",
              "TARGET_CONFLICT",
              "PLAN_STALE",
              "PLAN_EXPIRED",
              "IO_ERROR",
              "MUTATION_LOCKED",
              "RECOVERY_REQUIRED",
              "CANCELLED"
            ]
          },
          "message": {
            "type": "string"
          },
          "nextAction": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "code",
          "message",
          "nextAction"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "status",
    "data",
    "warnings",
    "errors"
  ],
  "additionalProperties": false
}
